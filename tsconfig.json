{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "scripts/preview-email.ts",
    "scripts/test-email.ts",
    "scripts/resend-dns.ts",
    "scripts/check-resend.ts",
    "scripts/seed-remote.ts",
    "scripts/verify-remote-login.ts",
    "scripts/check-azure.mts",
    "scripts/preview-digest.mts",
    "scripts/probe-narrate.mts",
    "scripts/probe-narrate2.mts"
  ]
}
