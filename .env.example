# ---------------------------------------------------------------------------
# NEXUS — configuration
#
# Copy to .env.local and fill in. .env* is gitignored; never commit real values.
#
# Everything here is optional. With none of it set, NEXUS runs entirely on a
# local PGlite database with seeded demo data and a persona switcher — which is
# how the interface is developed and how `npm run smoke:prod` verifies it.
# ---------------------------------------------------------------------------

# ---- Supabase: identity ----------------------------------------------------
# Set these two to turn on real authentication: Microsoft Entra ID, Google and
# email + password. Both keys are browser-safe; every table is behind RLS.
# Either key name works — the publishable key is the newer format.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Database ---------------------------------------------------------------
# Until this is set, NEXUS authenticates against Supabase (if configured above)
# but still reads and writes the local PGlite demo database.
#
# The database no longer has to be Supabase's — Supabase is identity-only now.
# Point this at whichever Postgres 17 you're using:
#   local dev     your own local Postgres install
#   staging/live  Neon (or wherever the environment is actually hosted)
#
# Percent-encode any of @ : / ? # % in the password.
#
# FIRST-TIME SETUP against a fresh Postgres (local, Neon, anywhere that isn't
# already a Supabase project) — run these once, in this exact order:
#
#   npm run db:setup-shim    # creates auth.uid() — must run BEFORE migrations,
#                             # since RLS policies reference it at creation time
#   npm run db:migrate       # applies all migrations in supabase/migrations
#   npm run db:grant-roles   # creates the `authenticated` role RLS runs under —
#                             # must run AFTER migrations, since it grants on
#                             # tables that don't exist yet otherwise
#
# pgvector must also be installed on the target Postgres. Neon has it built
# in; a local install usually needs it added separately.
DATABASE_URL=

# ---- AI runtime ------------------------------------------------------------
# Without these, extraction and narration use the deterministic mock provider,
# which is why the app works offline and why the tests are reproducible.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The high-volume jobs — extraction, drafting, answering — run here. Splitting
# the tiers took extraction from 15.1s to 7.9s; without it every keystroke-
# adjacent job pays reasoning-model latency for work that is mostly formatting.
# Falls back to AZURE_OPENAI_DEPLOYMENT when unset.
AZURE_OPENAI_FAST_DEPLOYMENT=

AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Email -----------------------------------------------------------------
# Invitation and digest delivery. Without a key, invitations still work — the
# link is shown in the UI to send by hand — rather than failing silently into
# an unconfigured transport.
#
# Resend sends only from a verified domain, except onboarding@resend.dev which
# delivers ONLY to the Resend account owner's own address.
RESEND_API_KEY=
EMAIL_FROM=NEXUS <onboarding@resend.dev>

# ---- Escape hatch ----------------------------------------------------------
# Allows the persona shim in a production build. Only for deliberately running
# the demo; a real deployment must never set this.
# NEXUS_ALLOW_DEMO_AUTH=1

# ---- Scheduling ------------------------------------------------------------
# The shared secret /api/cron/tick requires. Without it the endpoint refuses
# every request rather than running open — it emails the Chairman and notifies
# the whole organisation, so "unconfigured" must mean "off", never "public".
CRON_SECRET=

# Where links in emails point. Falls back to the request origin, which is
# wrong the moment a scheduler calls from inside a private network.
NEXT_PUBLIC_APP_URL=

# Optional: divert ALL outbound mail to one inbox for testing.
# Every message is composed exactly as in production, addressed to whoever
# it is really for, then handed to this address with a banner naming them.
NEXUS_MAIL_REDIRECT=
