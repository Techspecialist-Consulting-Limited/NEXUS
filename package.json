{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:check": "node scripts/check-migrations.mjs",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:prod": "node scripts/serve-and-smoke.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed:remote": "node --env-file-if-exists=.env.local scripts/seed-remote.ts",
    "ai:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-azure.mts",
    "digest:preview": "node --env-file-if-exists=.env.local --import tsx scripts/preview-digest.mts",
    "check:assistant": "node --env-file-if-exists=.env.local --import tsx scripts/check-assistant.mts",
    "smoke:assistant": "node scripts/smoke-assistant.mjs",
    "smoke:checkin": "node scripts/smoke-checkin.mjs",
    "check:intelligence": "node --env-file-if-exists=.env.local --import tsx scripts/check-intelligence.mts",
    "check:extract": "node --env-file-if-exists=.env.local --import tsx scripts/check-extract.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "openai": "^7.5.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.6.0",
    "workflow": "^4.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-pgvector": "^0.0.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
