# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents what has to be set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NEXUS local development
# local PGlite demo database, rebuilt from migrations + seed
# (a trailing comment is NOT supported here - it becomes part of the pattern)
/.pglite/
dev.log
dev.err.log
tsconfig.tsbuildinfo
/.smoke/

# Local server logs from verification runs
.smoke-run.log
prod.log
prod.err.log
